PORT=4000
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=xxxx
JWT_SECRET=ganti-dengan-string-acak-panjang
APP_TIMEZONE=Asia/Jakarta

# MQTT (HiveMQ Cloud) — untuk live tracking lokasi satpam
MQTT_URL=mqtts://xxxx.s1.eu.hivemq.cloud:8883
MQTT_USERNAME=username
MQTT_PASSWORD=password

# Interval simpan snapshot riwayat lokasi satpam (ms, default 20000 = 20 detik)
LOCATION_HISTORY_INTERVAL_MS=20000
